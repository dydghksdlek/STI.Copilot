<Window x:Class="STI.Copilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STI.Copilot"
        xmlns:controls="clr-namespace:STI.Copilot.Wpf.Controls;assembly=STI.Copilot.Wpf"
        mc:Ignorable="d"
        Title="STI Copilot"
        Icon="pack://application:,,,/STI.Copilot;component/STICopilot.ico"
        Height="760" Width="1120" MinHeight="560" MinWidth="880"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <!-- 커스텀 크롬. AllowsTransparency 로 라운드 모서리 + 강조 그림자를 직접 그린다. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="22" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <BitmapImage x:Key="BrandLogo" UriSource="pack://application:,,,/STI.Copilot.Wpf;component/res/STI_LOGO.png" DecodePixelWidth="80"/>
        <SolidColorBrush x:Key="Line"   Color="#E7E8EB"/>
        <SolidColorBrush x:Key="Muted2" Color="#6B7280"/>
        <SolidColorBrush x:Key="Hover"  Color="#ECEEF1"/>
        <SolidColorBrush x:Key="Red"    Color="#C0655A"/>

        <Geometry x:Key="IcoHamburger">M4 6h16M4 12h16M4 18h16</Geometry>
        <Geometry x:Key="IcoMin">M5 12h14</Geometry>
        <Geometry x:Key="IcoMax">M5 5H19V19H5Z</Geometry>
        <Geometry x:Key="IcoRestore">M8 8H18V18H8Z M8 8V6H16V16H14</Geometry>
        <Geometry x:Key="IcoClose">M6 6L18 18M18 6L6 18</Geometry>

        <!-- 타이틀바 아이콘 공통(중앙정렬 위해 Stretch=Uniform) -->
        <Style x:Key="TitleGlyph" TargetType="Path">
            <Setter Property="Fill" Value="{x:Null}"/>
            <Setter Property="Stroke" Value="{StaticResource Muted2}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>

        <!-- 좌측 사이드바 토글(라운드, 호버 회색) -->
        <Style x:Key="TitleToggleBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 창 버튼(최소화/최대화): 셀 꽉 채움, 호버 회색 -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 닫기 버튼: 셀 꽉 채움, 호버 빨강 + 흰 X -->
        <Style x:Key="WinCloseBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent">
                            <Viewbox Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="g" Style="{StaticResource TitleGlyph}" Data="{StaticResource IcoClose}"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Red}"/>
                                <Setter TargetName="g" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 바깥 여백(그림자 공간) + 라운드 카드. Grid 배경을 거의 투명(#01000000)으로 둬서
         그림자 여백에서도 마우스 이벤트를 받아 창 크기 조절(리사이즈)이 가능하게 한다. -->
    <Grid Background="#01000000">
        <Border x:Name="RootBorder" Margin="22" CornerRadius="12" Background="#FFFFFF">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Direction="270" Opacity="0.13" Color="#0C1017"/>
            </Border.Effect>
            <!-- 내용은 라운드 모서리로 잘라낸다(코드비하인드에서 Clip 갱신) -->
            <Grid x:Name="ContentHost" SizeChanged="ContentHost_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===== 상단 타이틀바 (셸 창 크롬) ===== -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 좌측: 로고 + 사이드바 토글 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="11,0,0,0">
                            <Image Source="{StaticResource BrandLogo}" Width="18" Height="18" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" SnapsToDevicePixels="True"
                                   Margin="0,0,6,0"/>
                            <Button Style="{StaticResource TitleToggleBtn}" ToolTip="사이드바 접기/펼치기"
                                    Command="{Binding ToggleSidebarCommand}">
                                <Viewbox Width="16" Height="16"><Path Style="{StaticResource TitleGlyph}" Data="{StaticResource IcoHamburger}"/></Viewbox>
                            </Button>
                        </StackPanel>

                        <!-- 우측: 최소화 / 최대화·복원 / 닫기 (셀 꽉 채움) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource WinBtn}" Click="Minimize_Click" ToolTip="최소화">
                                <Viewbox Width="11" Height="11"><Path Style="{StaticResource TitleGlyph}" Data="{StaticResource IcoMin}"/></Viewbox>
                            </Button>
                            <Button Style="{StaticResource WinBtn}" Click="MaxRestore_Click" ToolTip="최대화/복원">
                                <Viewbox Width="11" Height="11">
                                    <Path>
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource TitleGlyph}">
                                                <Setter Property="Data" Value="{StaticResource IcoMax}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                                        <Setter Property="Data" Value="{StaticResource IcoRestore}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource WinCloseBtn}" Click="Close_Click" ToolTip="닫기"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== 화면(대화 / RunBook) ===== -->
                <Grid Grid.Row="1">
                    <controls:ChatView x:Name="Chat"
                                       DataContext="{Binding Chat}"
                                       Visibility="{Binding DataContext.IsChat, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVis}}"/>
                    <controls:RunbookView x:Name="Runbook"
                                          DataContext="{Binding Runbook}"
                                          Visibility="{Binding DataContext.IsRunbook, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
