<UserControl x:Class="STI.Copilot.Wpf.Controls.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:STI.Copilot.Wpf.ViewModels"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="720" d:DesignWidth="1000"
             FontFamily="Segoe UI, Malgun Gothic, Pretendard"
             TextOptions.TextFormattingMode="Display"
             Background="#FFFFFF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 브랜드 로고 (res\STI_LOGO.png, Resource 로 내장). DecodePixelWidth 로 축소 시 선명도 확보. -->
        <BitmapImage x:Key="BrandLogo" UriSource="pack://application:,,,/STI.Copilot.Wpf;component/res/STI_LOGO.png"
                     DecodePixelWidth="120"/>

        <!-- ============ 색상 팔레트 (목업 디자인 토큰) ============ -->
        <SolidColorBrush x:Key="SidebarBg" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="MainBg"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Dark"      Color="#2F3A4C"/>
        <SolidColorBrush x:Key="DarkHover" Color="#3A4759"/>
        <SolidColorBrush x:Key="Accent"    Color="#3D4A63"/>
        <SolidColorBrush x:Key="AccentText" Color="#3D4353"/>
        <SolidColorBrush x:Key="Muted"     Color="#9AA1AC"/>
        <SolidColorBrush x:Key="Muted2"    Color="#6B7280"/>
        <SolidColorBrush x:Key="Line"      Color="#E7E8EB"/>
        <SolidColorBrush x:Key="BubbleAi"  Color="#F4F6F8"/>
        <SolidColorBrush x:Key="Highlight" Color="#EEF1F6"/>
        <SolidColorBrush x:Key="Green"     Color="#61C454"/>
        <SolidColorBrush x:Key="Yellow"    Color="#F5BD4F"/>
        <SolidColorBrush x:Key="Red"       Color="#C0655A"/>
        <SolidColorBrush x:Key="TextMain"  Color="#1E2329"/>
        <SolidColorBrush x:Key="InkFaint"  Color="#B3B8C0"/>
        <SolidColorBrush x:Key="TrackOff"  Color="#CBD1DA"/>
        <SolidColorBrush x:Key="TabBg"     Color="#ECEEF2"/>

        <!-- 근거 소스 체크박스(입력창 아래 런북/문서) -->
        <Style x:Key="SourcePill" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="b" CornerRadius="8" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="9,5">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path x:Name="ico" Style="{DynamicResource Icn}" StrokeThickness="1.8"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Viewbox>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Highlight}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 화면 전환 탭(세그먼트). 활성 탭은 흰 배경. -->
        <Style x:Key="NavTab" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}" Padding="5,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 아이콘 지오메트리 (SVG 24x24) ============ -->
        <Geometry x:Key="IcoPlus">M12 5v14M5 12h14</Geometry>
        <Geometry x:Key="IcoDoc">M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5</Geometry>
        <Geometry x:Key="IcoNotebook">M4 3h13a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4z M8 3v18 M12 8h4 M12 12h4</Geometry>
        <Geometry x:Key="IcoSend">M5 12h14M13 6l6 6-6 6</Geometry>
        <Geometry x:Key="IcoRefresh">M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5</Geometry>
        <Geometry x:Key="IcoTrash">M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14</Geometry>
        <Geometry x:Key="IcoChevron">M6 9l6 6 6-6</Geometry>
        <Geometry x:Key="IcoUpload">M12 15V4M7 9l5-5 5 5M4 20h16</Geometry>
        <Geometry x:Key="IcoHamburger">M4 6h16M4 12h16M4 18h16</Geometry>
        <Geometry x:Key="IcoCollapse">M15 6l-6 6 6 6M4 4v16</Geometry>
        <Geometry x:Key="IcoCheck">M5 12l4 4 10-10</Geometry>
        <Geometry x:Key="IcoWinMin">M5 12h14</Geometry>
        <Geometry x:Key="IcoWinMax">M5 5H19V19H5Z</Geometry>
        <Geometry x:Key="IcoWinRestore">M8 8H18V18H8Z M8 8V6H16V16H14</Geometry>
        <Geometry x:Key="IcoWinClose">M6 6L18 18M18 6L6 18</Geometry>
        <Geometry x:Key="IcoLayers">M12 3l9 4-9 4-9-4 9-4z M3 12l9 4 9-4 M3 16l9 4 9-4</Geometry>
        <!-- 채팅 말풍선(어시스턴트 아바타용). 좌하단 꼬리가 있는 라운드 말풍선. -->
        <Geometry x:Key="IcoChat">M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z</Geometry>
        <GeometryGroup x:Key="IcoSpark">
            <EllipseGeometry Center="12,12" RadiusX="4" RadiusY="4"/>
            <PathGeometry Figures="M12 2v3M12 19v3M2 12h3M19 12h3"/>
        </GeometryGroup>

        <!-- 선(stroke) 아이콘 공통 스타일. Viewbox로 감싸 크기 조절, 색은 사용처에서 지정. -->
        <Style x:Key="Icn" TargetType="Path">
            <Setter Property="Fill" Value="{x:Null}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <!-- ============ 버튼 스타일 ============ -->
        <!-- 진한 채움 버튼 (새 대화 / 보내기) -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Background="{StaticResource Dark}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource DarkHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 흰 배경 외곽선 버튼 (대화 초기화 등) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9" Background="White"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Highlight}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 정사각형 아이콘 버튼 (햄버거/접기) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9" Background="Transparent"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Highlight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 레일(접힘)용 아이콘 버튼: 테두리 없는 라운드 -->
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Highlight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 문자 링크형 버튼 (지식베이스 비우기) -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Red}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 창 버튼 (최소화/최대화/닫기) ============ -->
        <Style x:Key="WinButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#ECEEF1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="Transparent">
                            <Viewbox Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="g" Style="{StaticResource Icn}" StrokeThickness="1.6" Stretch="Uniform"
                                      Data="{StaticResource IcoWinClose}" Stroke="{StaticResource Muted2}"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Red}"/>
                                <Setter TargetName="g" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 토글 스위치 (문서 기반 답변) ============ -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="{StaticResource TrackOff}">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 모델 선택 콤보박스 (칩 스타일) ============ -->
        <Style x:Key="ModelItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="9,6" Margin="4,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Highlight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModelCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModelItem}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="b" Background="White" CornerRadius="8"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="8,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{StaticResource Green}"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Viewbox Grid.Column="2" Width="11" Height="11" Margin="5,0,0,0">
                                                    <Path Style="{StaticResource Icn}" Data="{StaticResource IcoChevron}" Stroke="{StaticResource Muted}"/>
                                                </Viewbox>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource Highlight}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        Margin="0,6,0,0" Padding="0,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.14" Color="#1E2329"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 슬림 진행바 ============ -->
        <Style x:Key="SlimBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="3" Background="#E3E7EE"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{StaticResource Accent}"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 섹션 소제목 (모델 / 지식베이스) -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, ui-monospace"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>

        <!-- ============ 문서 검색범위 목록(선택 가능) ============ -->
        <!-- 항목 컨테이너: 선택/호버 하이라이트 -->
        <Style x:Key="DocScopeItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="9" Padding="7,7" Margin="0,0,0,3" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F0F1F4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Highlight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 항목 내용: 아이콘 + 이름. "전체 문서"만 레이어 아이콘. -->
        <DataTemplate x:Key="DocScopeTemplate">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path x:Name="ic" Style="{StaticResource Icn}" Data="{StaticResource IcoDoc}" Stroke="{StaticResource Muted}"/>
                </Viewbox>
                <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="전체 문서">
                    <Setter TargetName="ic" Property="Data" Value="{StaticResource IcoLayers}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 말풍선 안의 선택·복사 가능한 텍스트 (읽기전용 TextBox). 기본 크롬 제거. -->
        <Style x:Key="MessageText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 대화 말풍선 ============ -->
        <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
            <Grid Margin="0,0,0,22">
                <!-- 사용자: 오른쪽 진한 말풍선 -->
                <Border x:Name="UserBubble" HorizontalAlignment="Right" MaxWidth="520"
                        Background="{StaticResource Dark}" CornerRadius="14,14,4,14" Padding="13,9">
                    <TextBox Style="{StaticResource MessageText}" Text="{Binding Content, Mode=OneWay}"
                             Foreground="White"/>
                </Border>

                <!-- 어시스턴트: 왼쪽 아바타 + 밝은 말풍선 (Grid 로 폭 제한 → 긴 글자 줄바꿈) -->
                <Grid x:Name="AiRow" HorizontalAlignment="Left" MaxWidth="700" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Background="{StaticResource Highlight}"
                            Margin="0,2,10,0" VerticalAlignment="Top">
                        <Viewbox Width="14" Height="14">
                            <Path Style="{StaticResource Icn}" Data="{StaticResource IcoChat}" Stroke="{StaticResource Accent}"/>
                        </Viewbox>
                    </Border>
                    <Border Grid.Column="1" HorizontalAlignment="Left" Background="{StaticResource BubbleAi}"
                            CornerRadius="4,14,14,14" Padding="14,10">
                        <StackPanel>
                            <TextBox x:Name="AiText" Style="{StaticResource MessageText}" Text="{Binding Content, Mode=OneWay}"
                                     Foreground="{StaticResource TextMain}"/>
                            <!-- 생성 중 타이핑 표시(…). IsGenerating 이 true 인 동안만 애니메이션. -->
                            <StackPanel x:Name="TypingDots" Orientation="Horizontal" Visibility="Collapsed" Margin="1,7,0,1">
                                <Ellipse x:Name="Dot1" Width="6" Height="6" Margin="0,0,4,0" Fill="{StaticResource Muted}" Opacity="0.25"/>
                                <Ellipse x:Name="Dot2" Width="6" Height="6" Margin="0,0,4,0" Fill="{StaticResource Muted}" Opacity="0.25"/>
                                <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="{StaticResource Muted}" Opacity="0.25"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="AiRow" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUser}" Value="False">
                    <Setter TargetName="UserBubble" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <!-- 아직 내용이 없으면(첫 토큰 전) 빈 줄 대신 점만 보이게 텍스트 숨김 -->
                <DataTrigger Binding="{Binding Content}" Value="">
                    <Setter TargetName="AiText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <!-- 생성 중이면 … 점을 켜고 물결처럼 깜빡이는 애니메이션 실행 -->
                <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                    <Setter TargetName="TypingDots" Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="TypingSB">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0"/>
                                <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="TypingSB"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ================= 레이아웃 ================= -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 슬림 레일 (사이드바 접힘) ========== -->
        <Border Grid.Column="0" Width="62" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="False" Margin="0,18">
                <Image DockPanel.Dock="Top" Source="{StaticResource BrandLogo}" Width="30" Height="30" Stretch="Uniform"
                       HorizontalAlignment="Center" Margin="0,0,0,15" RenderOptions.BitmapScalingMode="HighQuality"
                       UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                <Button DockPanel.Dock="Top" Style="{StaticResource RailButton}" HorizontalAlignment="Center"
                        Command="{Binding ToggleSidebarCommand}" ToolTip="펼치기" Margin="0,0,0,4"
                        Background="{StaticResource Highlight}">
                    <Viewbox Width="18" Height="18">
                        <Path Style="{StaticResource Icn}" Data="{StaticResource IcoHamburger}" Stroke="{StaticResource Accent}"/>
                    </Viewbox>
                </Button>
                <Button DockPanel.Dock="Top" Style="{StaticResource RailButton}" HorizontalAlignment="Center"
                        Command="{Binding ClearCommand}" ToolTip="새 대화">
                    <Viewbox Width="18" Height="18">
                        <Path Style="{StaticResource Icn}" Data="{StaticResource IcoPlus}" Stroke="{StaticResource Muted}"/>
                    </Viewbox>
                </Button>
                <Grid DockPanel.Dock="Top" HorizontalAlignment="Center" Width="38" Height="38">
                    <Viewbox Width="18" Height="18">
                        <Path Style="{StaticResource Icn}" Data="{StaticResource IcoDoc}" Stroke="{StaticResource Muted}"/>
                    </Viewbox>
                    <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Accent}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Documents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Documents.Count}" Foreground="White" FontSize="8" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <Ellipse DockPanel.Dock="Bottom" Width="8" Height="8" HorizontalAlignment="Center" Fill="{StaticResource Green}"/>
            </DockPanel>
        </Border>

        <!-- ========== 전체 사이드바 (펼침) ========== -->
        <Border Grid.Column="0" Width="264" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"
                Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVis}}">
            <Grid Margin="14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 로고 + 접기 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 새 대화 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 모델 라벨 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 모델 칩 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 지식베이스 헤더 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 문서 기반 토글 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 드롭존 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 인덱싱 진행 카드 -->
                    <RowDefinition Height="*"/>
                    <!-- 문서 목록 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 하단 상태 -->
                </Grid.RowDefinitions>

                <!-- 화면전환 탭 (로고·접기 버튼은 셸 타이틀바로 이동) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <!-- 화면 전환 탭 -->
                    <Border Background="{StaticResource TabBg}" CornerRadius="9" Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="💬 대화"
                                    Command="{Binding DataContext.ShowChatCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavTab}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ActiveTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="chat">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1" Content="🗂 RunBook"
                                    Command="{Binding DataContext.ShowRunbookCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavTab}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ActiveTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="runbook">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 새 대화 -->
                <Button Grid.Row="1" Style="{StaticResource DarkButton}" Padding="0,8" Margin="0,0,0,14"
                        Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                            <Path Style="{StaticResource Icn}" Data="{StaticResource IcoPlus}" Stroke="White"/>
                        </Viewbox>
                        <TextBlock Text="새 대화" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- 모델 선택은 입력창 하단으로 이동됨 (Row 2·3 비움) -->

                <!-- 지식베이스 헤더 -->
                <Grid Grid.Row="4" Margin="4,0,0,10">
                    <TextBlock Text="지식베이스" Style="{StaticResource SectionLabel}"/>
                    <Border HorizontalAlignment="Right" CornerRadius="10" Background="#12141A1E" Padding="7,2">
                        <TextBlock Text="{Binding Documents.Count}" FontFamily="Consolas, ui-monospace" FontSize="10.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource Muted2}"/>
                    </Border>
                </Grid>

                <!-- 스캔 PDF OCR 토글 -->
                <Border Grid.Row="5" Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" Padding="10,7" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid ToolTip="이미지로 된 스캔 PDF에서 글자를 인식합니다. 켜면 느려집니다. 다음 인덱싱부터 적용.">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="스캔 PDF OCR" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentText}"/>
                                <TextBlock Text="이미지 PDF용 · 느림" FontFamily="Consolas, ui-monospace" FontSize="9"
                                           Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding UseOcr, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 드롭존 -->
                <Border Grid.Row="6" x:Name="Dropzone" CornerRadius="11" Background="White" Padding="10,12" Margin="0,0,0,10"
                        AllowDrop="True" DragOver="Dropzone_DragOver" DragLeave="Dropzone_DragLeave" Drop="Dropzone_Drop">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#3D4A63" Opacity="0.28"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1.5</Border.BorderThickness>
                    <StackPanel HorizontalAlignment="Center">
                        <Viewbox Width="17" Height="17" Margin="0,0,0,5">
                            <Path Style="{StaticResource Icn}" StrokeThickness="1.5" Data="{StaticResource IcoUpload}" Stroke="{StaticResource Accent}"/>
                        </Viewbox>
                        <TextBlock Text="여기로 문서를 끌어다 놓기" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="또는" FontFamily="Consolas, ui-monospace" FontSize="9.5"
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,3,0,7"/>
                        <Button Style="{StaticResource GhostButton}" Padding="10,5" HorizontalAlignment="Center"
                                Command="{Binding LoadDocumentsCommand}" Foreground="{StaticResource AccentText}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                    <Path Style="{StaticResource Icn}" Data="{StaticResource IcoDoc}" Stroke="{StaticResource AccentText}"/>
                                </Viewbox>
                                <TextBlock Text="문서 불러오기" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 인덱싱 진행 카드 (인덱싱 중에만) -->
                <Border Grid.Row="7" Background="White" CornerRadius="10" BorderThickness="1" Padding="12,10" Margin="0,0,0,10"
                        Visibility="{Binding IsIngesting, Converter={StaticResource BoolToVis}}">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#3D4A63" Opacity="0.18"/>
                    </Border.BorderBrush>
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Style="{StaticResource Icn}" Data="{StaticResource IcoDoc}" Stroke="{StaticResource Accent}"/>
                                </Viewbox>
                                <TextBlock Text="인덱싱 중" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 인덱싱 취소 -->
                            <Button Style="{StaticResource WinButton}" Width="24" Height="24" HorizontalAlignment="Right"
                                    Command="{Binding CancelIngestCommand}" ToolTip="인덱싱 정지">
                                <Viewbox Width="11" Height="11">
                                    <Path Style="{StaticResource Icn}" StrokeThickness="1.6" Data="{StaticResource IcoWinClose}"
                                          Stroke="{StaticResource Muted2}"/>
                                </Viewbox>
                            </Button>
                        </Grid>
                        <ProgressBar Style="{StaticResource SlimBar}" Minimum="0" Maximum="100"
                                     Value="{Binding IngestProgress}" Margin="0,8,0,6"/>
                        <TextBlock Text="{Binding IngestStatus}" FontFamily="Consolas, ui-monospace" FontSize="9.5"
                                   Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- 문서 목록(검색 범위 선택). 문서를 고르면 그 문서 안에서만 답변, "전체 문서"면 전체 검색. -->
                <ListBox Grid.Row="8" Margin="0,0,0,4" ItemsSource="{Binding DocumentScopes}"
                         SelectedItem="{Binding SelectedScope, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource DocScopeItem}"
                         ItemTemplate="{StaticResource DocScopeTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch"/>

                <!-- 하단 상태 + 비우기 -->
                <Grid Grid.Row="9" Margin="2,14,2,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Green}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIngesting}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Yellow}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontFamily="Consolas, ui-monospace" FontSize="11"
                                   Foreground="{StaticResource Muted2}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                    </StackPanel>
                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                            Command="{Binding ClearKnowledgeBaseCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource Icn}" Data="{StaticResource IcoTrash}" Stroke="{StaticResource Red}"/>
                            </Viewbox>
                            <TextBlock Text="비우기" FontSize="10.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ========== 메인 대화 영역 ========== -->
        <Grid Grid.Column="1" Background="{StaticResource MainBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 헤더 -->
                <RowDefinition Height="*"/>
                <!-- 메시지 -->
                <RowDefinition Height="Auto"/>
                <!-- 출처 -->
                <RowDefinition Height="Auto"/>
                <!-- 입력 -->
            </Grid.RowDefinitions>

            <!-- 헤더 (OS 타이틀바 대체: 빈 영역 드래그로 창 이동) -->
            <Border Grid.Row="0" Height="44" Background="Transparent"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 상단 좌측 작은 아이콘(일반 이미지). TitleIcon 미지정 시 자동 숨김. -->
                        <Image Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"
                               Source="{Binding TitleIcon, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <Trigger Property="Source" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="대화" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMain}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Padding="9,4" Command="{Binding ClearCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="12" Height="12" Margin="0,0,5,0">
                                    <Path Style="{StaticResource Icn}" Data="{StaticResource IcoRefresh}" Stroke="{StaticResource Muted2}"/>
                                </Viewbox>
                                <TextBlock Text="대화 초기화" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- 창 버튼(최소화/최대화/닫기)은 셸 타이틀바로 이동됨 -->
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 메시지 목록 -->
            <ScrollViewer Grid.Row="1" x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto"
                          Padding="28,20" ScrollChanged="MessagesScroll_ScrollChanged">
                <Grid>
                    <!-- 빈 상태 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource BubbleAi}"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Viewbox Width="24" Height="24">
                                <Path Style="{StaticResource Icn}" StrokeThickness="1.5" Data="{StaticResource IcoSpark}" Stroke="{StaticResource Accent}"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="무엇을 도와드릴까요?" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                        <TextBlock Text="무엇을 도와드릴까요?"
                                   FontSize="13.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 실제 메시지 -->
                    <ItemsControl ItemsSource="{Binding Messages}"/>
                </Grid>
            </ScrollViewer>

            <!-- 출처 표시: 근거마다 칩 1개, 많으면 여러 줄로 자동 줄바꿈 -->
            <Border Grid.Row="2" Margin="28,0,28,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSources}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="출처" FontFamily="Consolas, ui-monospace" FontSize="10.5"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,4,8,0"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding LastSources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="7,2,8,3" Margin="0,0,5,5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EEF0F3"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunbook}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Highlight}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Kind}" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 입력 영역 -->
            <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,9,20,11">
                <StackPanel>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Background="White"
                            Padding="13,4,5,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <TextBox x:Name="InputBox" BorderThickness="0" Background="Transparent"
                                         Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto" FontSize="13" Padding="0,4"
                                         Foreground="{StaticResource TextMain}" VerticalContentAlignment="Center"
                                         PreviewKeyDown="InputBox_PreviewKeyDown"/>
                                <TextBlock Text="메시지를 입력하세요…" FontSize="13" Foreground="{StaticResource Muted}"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Padding="0,4" Margin="2,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InputText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid Grid.Column="1" VerticalAlignment="Bottom">
                                <!-- 전송 (생성 중이 아닐 때) -->
                                <Button Width="32" Height="32" Command="{Binding SendCommand}" ToolTip="보내기">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icn}" Stretch="Uniform" Data="{StaticResource IcoSend}" Stroke="White"/>
                                    </Viewbox>
                                </Button>
                                <!-- 정지 (생성 중일 때) -->
                                <Button Style="{StaticResource DarkButton}" Width="32" Height="32" Command="{Binding StopCommand}"
                                        ToolTip="생성 정지"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                    <Rectangle Width="7" Height="7" RadiusX="2" RadiusY="2" Fill="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 하단 바: 좌측 근거 소스 칩 · 우측 모델 선택 -->
                    <Grid Margin="2,7,0,0">
                        <!-- 근거 소스: 체크하면 해당 소스에서만 근거를 찾아 답한다(엄격). 둘 다 해제면 자유 대화. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource SourcePill}" Content="RunBook" Tag="{StaticResource IcoNotebook}"
                                      IsChecked="{Binding UseRunbook, Mode=TwoWay}"
                                      ToolTip="등록된 런북(장비 조치·운영·매뉴얼)에서만 근거를 찾아 답합니다."/>
                            <CheckBox Style="{StaticResource SourcePill}" Content="문서" Tag="{StaticResource IcoDoc}" Margin="0"
                                      IsChecked="{Binding UseDocuments, Mode=TwoWay}"
                                      ToolTip="등록된 문서에서만 근거를 찾아 답합니다."/>
                        </StackPanel>
                        <!-- GPU 토글 + 모델 선택 (우측 하단) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox Content="GPU" IsChecked="{Binding UseGpu, Mode=TwoWay}" VerticalAlignment="Center"
                                      Margin="0,0,10,0" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted2}"
                                      ToolTip="채팅 생성을 GPU로 실행(테스트용). 구형 GPU(GTX 1060 등)는 크래시할 수 있습니다. 해제 시 CPU. 임베딩은 항상 CPU."/>
                            <ComboBox MinWidth="140" MaxWidth="220" VerticalAlignment="Center"
                                      Style="{StaticResource ModelCombo}"
                                      ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock FontFamily="Consolas, ui-monospace" FontSize="10.5" Foreground="{StaticResource InkFaint}"
                               HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Run Text="{Binding StatusText, Mode=OneWay}"/><Run Text=" · 응답은 로컬에서 생성됩니다"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
