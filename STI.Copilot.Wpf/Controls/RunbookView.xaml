<UserControl x:Class="STI.Copilot.Wpf.Controls.RunbookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:STI.Copilot.Wpf.ViewModels"
             xmlns:rb="clr-namespace:STI.Copilot.Core.Runbook;assembly=STI.Copilot.Core"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="700" d:DesignWidth="1000"
             FontFamily="Segoe UI, Malgun Gothic, Pretendard"
             TextOptions.TextFormattingMode="Display" Background="#FFFFFF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 팔레트 -->
        <SolidColorBrush x:Key="SidebarBg" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="Dark"      Color="#2F3A4C"/>
        <SolidColorBrush x:Key="DarkHover" Color="#3A4759"/>
        <SolidColorBrush x:Key="Accent"    Color="#3D4A63"/>
        <SolidColorBrush x:Key="AccentText" Color="#3D4353"/>
        <SolidColorBrush x:Key="Muted"     Color="#9AA1AC"/>
        <SolidColorBrush x:Key="Muted2"    Color="#6B7280"/>
        <SolidColorBrush x:Key="Line"      Color="#E7E8EB"/>
        <SolidColorBrush x:Key="Line2"     Color="#EDEEF1"/>
        <SolidColorBrush x:Key="Hi"        Color="#EEF1F6"/>
        <SolidColorBrush x:Key="Green"     Color="#4C9E5A"/>
        <SolidColorBrush x:Key="GreenBg"   Color="#E6F3E8"/>
        <SolidColorBrush x:Key="Red"       Color="#C0655A"/>
        <SolidColorBrush x:Key="RedBg"     Color="#F6E5E2"/>
        <SolidColorBrush x:Key="TextMain"  Color="#1E2329"/>
        <SolidColorBrush x:Key="TabBg"     Color="#ECEEF2"/>

        <BitmapImage x:Key="BrandLogo" UriSource="pack://application:,,,/STI.Copilot.Wpf;component/res/STI_LOGO.png" DecodePixelWidth="120"/>

        <Geometry x:Key="IcoPlus">M12 5v14M5 12h14</Geometry>
        <Geometry x:Key="IcoWinMin">M5 12h14</Geometry>
        <Geometry x:Key="IcoWinMax">M5 5H19V19H5Z</Geometry>
        <Geometry x:Key="IcoWinClose">M6 6L18 18M18 6L6 18</Geometry>
        <Geometry x:Key="IcoSearch">M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4-4</Geometry>

        <Style x:Key="Icn" TargetType="Path">
            <Setter Property="Fill" Value="{x:Null}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <!-- 화면 전환 탭 (세그먼트, 높이 낮게) -->
        <Style x:Key="NavTab" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 진한 버튼 (항목 추가) -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Background="{StaticResource Dark}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource DarkHover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 카테고리 칩 -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="20" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="12,7">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 창 버튼 -->
        <Style x:Key="WinButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="42"/><Setter Property="Height" Value="32"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="8" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#ECEEF1"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="WinCloseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="42"/><Setter Property="Height" Value="32"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="8" Background="Transparent">
                        <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"><Path x:Name="g" Style="{StaticResource Icn}" StrokeThickness="1.6" Stretch="Uniform" Data="{StaticResource IcoWinClose}" Stroke="{StaticResource Muted2}"/></Viewbox>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Red}"/><Setter TargetName="g" Property="Stroke" Value="White"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <!-- 세그먼트 필터 버튼 (활성=흰 칸) -->
        <Style x:Key="SegBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}" Padding="11,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 토글 스위치 (폐기 포함) -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="34" Height="18" CornerRadius="9" Background="#CBD1DA">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 폼 입력 -->
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="9" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 목록 항목 액션 버튼 -->
        <Style x:Key="ItemBtn" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hi}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 삭제(위험) 버튼: 빨강 계열 -->
        <Style x:Key="ItemBtnDanger" TargetType="Button" BasedOn="{StaticResource ItemBtn}">
            <Setter Property="Foreground" Value="{StaticResource Red}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource RedBg}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Red}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 목록 항목 템플릿 -->
        <DataTemplate DataType="{x:Type rb:RunbookEntry}">
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMain}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Border x:Name="catPill" CornerRadius="6" Padding="8,2" Margin="9,0,0,0" VerticalAlignment="Center" Background="#F0F1F4">
                                <TextBlock Text="{Binding Category}" FontFamily="Consolas, ui-monospace" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Muted2}"/>
                            </Border>
                        </StackPanel>
                        <!-- 식별 키 칩 (값 있을 때만) -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasKeys}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border CornerRadius="6" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center" Background="#EFEAF6">
                                <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Code}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock FontFamily="Consolas, ui-monospace" FontSize="10.5" FontWeight="Bold" Foreground="#6A5AA0">
                                    <Run Text="⚠ "/><Run Text="{Binding Code, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                            <Border CornerRadius="6" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center" Background="#E4EEF2">
                                <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Module}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock FontFamily="Consolas, ui-monospace" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Muted2}">
                                    <Run Text="⧉ "/><Run Text="{Binding Module, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding Tags}" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Tags}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <!-- 내용: 기본 2줄 미리보기, "자세히 보기"를 누르면 전문 표시(읽기 전용) -->
                        <TextBlock x:Name="contentText" Text="{Binding Content}" FontSize="12.5" Foreground="{StaticResource Muted2}"
                                   TextWrapping="Wrap" Margin="0,5,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="MaxHeight" Value="38"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                            <Setter Property="MaxHeight" Value="100000"/>
                                            <Setter Property="TextTrimming" Value="None"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- 자세히 보기 / 접기 토글. ListBoxItem.IsSelected 와 연동(가상화 안전, 한 번에 하나 펼침) -->
                        <ToggleButton HorizontalAlignment="Left" Cursor="Hand" Margin="0,5,0,0"
                                      IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,1">
                                        <TextBlock x:Name="lbl" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="⌄ 자세히 보기"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="lbl" Property="Text" Value="⌃ 접기"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Author}" FontFamily="Consolas, ui-monospace" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding CreatedAt}" FontFamily="Consolas, ui-monospace" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding Id}" FontFamily="Consolas, ui-monospace" FontSize="11" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <Border x:Name="statusPill" CornerRadius="20" Padding="10,4" HorizontalAlignment="Right" Background="{StaticResource GreenBg}">
                            <TextBlock x:Name="statusText" Text="활성" FontFamily="Consolas, ui-monospace" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Green}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                            <!-- 수정 (활성만) -->
                            <Button Content="수정" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ItemBtn}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- 폐기 (활성만) -->
                            <Button Content="폐기" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.DeprecateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ItemBtn}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- 복원 (폐기만) -->
                            <Button Content="복원" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ItemBtn}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- 삭제 (항상) -->
                            <Button Content="삭제" Style="{StaticResource ItemBtnDanger}" Margin="0" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Border.Style>
                    <Style TargetType="Border"><Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Background" Value="#FAFAFB"/>
                        </DataTrigger>
                    </Style.Triggers></Style>
                </Border.Style>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Category}" Value="조치"><Setter TargetName="catPill" Property="Background" Value="#F6EBDF"/></DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="운영"><Setter TargetName="catPill" Property="Background" Value="#E1EFF3"/></DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="매뉴얼"><Setter TargetName="catPill" Property="Background" Value="#EAEAF6"/></DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="statusPill" Property="Background" Value="{StaticResource RedBg}"/>
                    <Setter TargetName="statusText" Property="Text" Value="폐기"/>
                    <Setter TargetName="statusText" Property="Foreground" Value="{StaticResource Red}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 사이드바 -->
        <Border Grid.Column="0" Width="264" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"
                Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="13,14">
                <!-- 화면 전환 탭 (로고는 셸 타이틀바로 이동) -->
                <Border DockPanel.Dock="Top" Background="{StaticResource TabBg}" CornerRadius="9" Padding="3" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="💬 대화"
                                Command="{Binding DataContext.ShowChatCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTab}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="chat">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="1" Content="🗂 RunBook"
                                Command="{Binding DataContext.ShowRunbookCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTab}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="runbook">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- 현황 -->
                <TextBlock DockPanel.Dock="Top" Text="현황" FontFamily="Consolas, ui-monospace" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,0,0,9"/>
                <Border DockPanel.Dock="Top" Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CountAll}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                            <TextBlock Text=" 개 항목" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted2}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock FontSize="11.5" Foreground="{StaticResource Green}" Margin="0,0,14,0">
                                <Run Text="● 활성 "/><Run Text="{Binding ActiveCount, Mode=OneWay}" FontFamily="Consolas, ui-monospace"/>
                            </TextBlock>
                            <TextBlock FontSize="11.5" Foreground="{StaticResource Red}">
                                <Run Text="● 폐기 "/><Run Text="{Binding DeprecatedCount, Mode=OneWay}" FontFamily="Consolas, ui-monospace"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 유지보수: 전체 재임베딩 (지금은 항상 표시 · 나중에 관리자만) -->
                <Border DockPanel.Dock="Top" Margin="0,12,0,0" Background="White" CornerRadius="10"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,10">
                    <StackPanel>
                        <TextBlock Text="유지보수" FontFamily="Consolas, ui-monospace" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" Margin="1,0,0,7"/>
                        <Button Command="{Binding ReindexCommand}" Cursor="Hand" ToolTip="모든 항목을 다시 임베딩(벡터 재생성). 기존 벡터는 .bak 로 백업.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="8" Background="{StaticResource Dark}" Padding="0,8">
                                        <TextBlock Text="⟳ 전체 재임베딩" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource DarkHover}"/></Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- 진행바(재임베딩 중) -->
                        <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding ReindexProgress, Mode=OneWay}" Margin="0,8,0,0"
                                     Background="#E3E7EE" Foreground="{StaticResource Accent}" BorderThickness="0"
                                     Visibility="{Binding IsReindexing, Converter={StaticResource BoolToVis}}"/>
                        <!-- 상태 텍스트(값 있을 때만) -->
                        <TextBlock Text="{Binding ReindexStatus}" FontSize="10.5" Foreground="{StaticResource Muted2}" Margin="1,5,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReindexStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" HorizontalAlignment="Left" FontFamily="Consolas, ui-monospace" FontSize="11.5" Foreground="{StaticResource Muted2}">
                    <Run Text="● " Foreground="{StaticResource Green}"/><Run Text="준비됨"/>
                </TextBlock>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- 메인 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 헤더 -->
            <Border Grid.Row="0" Height="44" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="Transparent"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0">
                    <TextBlock Text="RunBook" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource DarkButton}" Padding="10,6" Command="{Binding OpenAddCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0"><Path Style="{StaticResource Icn}" Data="{StaticResource IcoPlus}" Stroke="White"/></Viewbox>
                                <TextBlock Text="항목 추가" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 툴바 -->
            <Border Grid.Row="1" BorderBrush="{StaticResource Line2}" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0"><Path Style="{StaticResource Icn}" Data="{StaticResource IcoSearch}" Stroke="{StaticResource Muted}"/></Viewbox>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" FontSize="13.5" VerticalContentAlignment="Center"
                                         Foreground="{StaticResource TextMain}" TextChanged="SearchBox_TextChanged"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="상황·내용·코드·모듈·태그로 검색 (예: E-12, 냉각팬)" FontSize="13.5" Foreground="{StaticResource Muted}" IsHitTestVisible="False" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource TabBg}" CornerRadius="8" Padding="3" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SelectAllCommand}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SegBtn}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAll}" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource AccentText}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <TextBlock><Run Text="전체 "/><Run Text="{Binding CountAll, Mode=OneWay}" FontFamily="Consolas, ui-monospace" FontWeight="Bold"/></TextBlock>
                            </Button>
                            <Button Command="{Binding SelectActionCommand}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SegBtn}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAction}" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource AccentText}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <TextBlock><Run Text="조치 "/><Run Text="{Binding CountAction, Mode=OneWay}" FontFamily="Consolas, ui-monospace" FontWeight="Bold"/></TextBlock>
                            </Button>
                            <Button Command="{Binding SelectOperationCommand}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SegBtn}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOperation}" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource AccentText}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <TextBlock><Run Text="운영 "/><Run Text="{Binding CountOperation, Mode=OneWay}" FontFamily="Consolas, ui-monospace" FontWeight="Bold"/></TextBlock>
                            </Button>
                            <Button Command="{Binding SelectManualCommand}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SegBtn}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManual}" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource AccentText}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <TextBlock><Run Text="매뉴얼 "/><Run Text="{Binding CountManual, Mode=OneWay}" FontFamily="Consolas, ui-monospace" FontWeight="Bold"/></TextBlock>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="폐기 포함" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted2}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowDeprecated, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 목록 -->
            <Grid Grid.Row="2">
                <!-- 가상화 목록: 보이는 항목만 렌더링(수백~수천 개도 즉시 열림).
                     ListBox 를 쓰되 선택 하이라이트/테두리를 없애 카드 목록처럼 보이게 한다. -->
                <ListBox ItemsSource="{Binding Items}"
                         Background="Transparent" BorderThickness="0" Padding="20,16"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style><Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></StackPanel.Style>
                    <TextBlock Text="항목이 없습니다" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Muted2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="＋ 항목 추가 로 조치·운영·매뉴얼을 등록하세요" FontSize="12.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== 항목 추가 오버레이 ===== -->
        <Grid Grid.ColumnSpan="2" Background="#59141A24"
              Visibility="{Binding IsAddOpen, Converter={StaticResource BoolToVis}}">
            <!-- UseLayoutRounding: 중앙정렬 시 반픽셀 위치로 글자가 흐려지는 것 방지.
                 TextFormattingMode=Display: 작은 글자를 픽셀에 맞춰 또렷하게. -->
            <Border Width="560" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="White" CornerRadius="16"
                    UseLayoutRounding="True" SnapsToDevicePixels="True"
                    TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.3" Color="#0C1017"/></Border.Effect>
                <DockPanel>
                    <!-- 헤더 -->
                    <Grid DockPanel.Dock="Top" Margin="18,10">
                        <TextBlock Text="{Binding FormTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource WinButton}" Width="26" Height="26" HorizontalAlignment="Right" Command="{Binding CancelAddCommand}">
                            <Viewbox Width="11" Height="11"><Path Style="{StaticResource Icn}" StrokeThickness="1.6" Stretch="Uniform" Data="{StaticResource IcoWinClose}" Stroke="{StaticResource Muted2}"/></Viewbox>
                        </Button>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}"/>

                    <!-- 푸터 -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#FCFCFD" Padding="22,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="취소" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted2}" Cursor="Hand" Command="{Binding CancelAddCommand}" Margin="0,0,10,0">
                                <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="10" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18,10"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                            </Button>
                            <Button Style="{StaticResource DarkButton}" Padding="22,10" Command="{Binding SaveCommand}">
                                <TextBlock Text="저장" FontSize="13" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 본문 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,18">
                        <TextBlock Text="상황 / 제목" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,0,0,7"/>
                        <TextBox Style="{StaticResource FormInput}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MaxHeight="72" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding NewTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="카테고리" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,16,0,7"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetNewActionCommand}" Margin="0,0,7,0">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Chip}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNewAction}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <TextBlock Text="조치"/>
                            </Button>
                            <Button Command="{Binding SetNewOperationCommand}" Margin="0,0,7,0">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Chip}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNewOperation}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <TextBlock Text="운영"/>
                            </Button>
                            <Button Command="{Binding SetNewManualCommand}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Chip}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNewManual}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <TextBlock Text="매뉴얼"/>
                            </Button>
                        </StackPanel>

                        <!-- 식별 키 (선택): 알람/코드 · 모듈 ID -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="알람/코드 (선택)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,0,0,7"/>
                                <TextBox Style="{StaticResource FormInput}" Text="{Binding NewCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="모듈/장치 ID (선택)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,0,0,7"/>
                                <TextBox Style="{StaticResource FormInput}" Text="{Binding NewModule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="태그 (선택 · 쉼표로 구분)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,16,0,7"/>
                        <TextBox Style="{StaticResource FormInput}" Text="{Binding NewTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="내용" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,16,0,7"/>
                        <TextBox Style="{StaticResource FormInput}" Height="108" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding NewContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- 비슷한 기존 항목 (대체 후보): 입력 멈추면 자동 검색 -->
                        <StackPanel Margin="0,18,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFindingSimilar}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding HasSimilar}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="비슷한 기존 항목" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,0,0,8"/>

                            <!-- 로딩: 원형 스피너 + 점 1→5→1 (각 요소가 자기 자신을 애니메이션) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4"
                                        Visibility="{Binding IsFindingSimilar, Converter={StaticResource BoolToVis}}">
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                    <Path Stroke="{StaticResource Accent}" StrokeThickness="2.4" Fill="{x:Null}"
                                          StrokeStartLineCap="Round" RenderTransformOrigin="0.5,0.5" Data="M9 2 A7 7 0 1 1 2 9">
                                        <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFindingSimilar}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SpinSb">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="SpinSb"/></DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Viewbox>
                                <TextBlock Text="비슷한 항목 찾는 중" FontSize="12.5" Foreground="{StaticResource Muted2}" VerticalAlignment="Center" Margin="9,0,3,0"/>
                                <!-- 점: 클리핑 폭을 1개→5개 폭으로 늘렸다 줄여 개수 증감 표현 -->
                                <Border ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Center" Width="7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFindingSimilar}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="DotsSb">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Width" From="7" To="35" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="DotsSb"/></DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource Muted2}" Margin="1.5,0"/>
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource Muted2}" Margin="1.5,0"/>
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource Muted2}" Margin="1.5,0"/>
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource Muted2}" Margin="1.5,0"/>
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource Muted2}" Margin="1.5,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 결과 리스트 -->
                            <ItemsControl ItemsSource="{Binding SimilarItems}" Visibility="{Binding HasSimilar, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFAFB" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                          ToolTip="체크하면 저장 시 이 항목을 폐기합니다."/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Entry.Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Entry.Content}" FontSize="11" Foreground="{StaticResource Muted2}" TextTrimming="CharacterEllipsis" MaxHeight="16" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="20" Background="{StaticResource Hi}" Padding="8,3" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ScoreText}" FontFamily="Consolas, ui-monospace" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="체크한 항목은 저장 시 폐기됩니다(대체)." FontSize="11" Foreground="{StaticResource Muted}" Margin="2,1,0,0"
                                       Visibility="{Binding HasSimilar, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
